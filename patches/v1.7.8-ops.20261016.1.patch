+        if kept + cost <= budget:
+            kept += cost
+            continue
+        item = dict(message)
+        item["reasoning_content"] = DEEPSEEK_REASONING_PLACEHOLDER
+        if "reasoning" in item:
+            item["reasoning"] = DEEPSEEK_REASONING_PLACEHOLDER
+        out[index] = item
+    return out
