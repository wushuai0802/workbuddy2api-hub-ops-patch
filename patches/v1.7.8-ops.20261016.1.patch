+class _QuoteContext:
+    """Bounded detection-only quotation state, with character lookahead.
+
+    Adapted from the supplied v1.7.5-r2 reference. It masks quote spans rather
+    than exempting a whole surrounding planning line, without rewriting SSE.
+    """
+    LIMIT = 65536
+
+    def __init__(self):
+        self.quote = None
+        self.count = 0
+        self.escaped = False
+        self.previous = ""
+        self.pending = ""
+        self.expired = False
+
+    def copy(self):
+        result = _QuoteContext()
+        result.__dict__.update(self.__dict__)
+        return result
+
+    def _consume(self, char, after):
+        protected = self.quote is not None
+        if protected:
+            self.count += 1
+            if self.count > self.LIMIT:
+                self.quote, self.count = None, 0
+                self.expired = True
+                protected = False
+        before, self.previous = self.previous, char
+        if self.escaped:
+            self.escaped = False
+            return protected
+        if char == "\\":
+            self.escaped = True
+            return protected
+        if char not in ('"', "'", '“', '”', '‘', '’'):
+            return protected
+        if char in ("'", '’') and before.isalpha() and after.isalpha():
+            return protected
+        if self.quote is not None:
+            if char == self.quote:
+                self.quote, self.count = None, 0
+            return True
+        if char in ('”', '’'):
+            return True
+        if char == "'" and before and not (before.isspace() or before in '([{:,'):
+            return False
+        if char == '"' and before.isdigit():
+            return False
+        self.quote = {'“': '”', '‘': '’'}.get(char, char)
+        self.count = 0
+        return True
+
+    def feed(self, char):
+        self.expired = False
+        protected = self._consume(self.pending, char) if self.pending else False
+        self.pending = char
+        if char == '\n':
+            protected = self._consume(char, '') or protected
+            self.pending = ''
+            self.escaped = False
+        return protected
+
+    def preview(self):
+        state = self.copy()
+        return state._consume(state.pending, '') if state.pending else state.quote is not None
+
+
+class ReasoningLoopGuard:
+    """Bounded tail tracker that latches once a repetition loop is seen."""
+
+    def __init__(self, conservative=False):
+        self.tail = ""
+        self.hit = False
+        self.detail = ""
+        self.conservative = conservative
+        self.line = ""
+        self.line_blocked = False
+        self.fence = None
+        self.scanned = 0
+        self.fast = FastStallGuard(conservative)
+        self.total_chars = 0
+        self.rule = ""
+        self.quote_context = _QuoteContext()
+        self.quote_view = ""
+        self.quote_line_start = False
+
+    def _check(self, candidate):
+        detail = detect_reasoning_loop(candidate[-REASON_LOOP_TAIL:], self.conservative)
+        if detail:
+            self.hit, self.detail = True, detail
+            self.rule = "exact" if detail.startswith("repeated unit") else "churn"
+        return self.hit
+
+    def _line_state(self, complete=False):
+        stripped = self.line.lstrip()
+        match = re.match(r"(`{3,}|~{3,})", stripped)
+        marker = match.group(1) if match else None
+        if self.quote_line_start:
+            marker = None
+        safe = _prose_line(self.line)
+        # Latch structured lines at deterministic checkpoints so a long code
+        # prefix cannot fall out of the bounded window and become prose.
+        if self.line.strip() and not safe:
+            self.line_blocked = True
+        if self.line_blocked:
+            safe = ""
+        if safe:
+            pending = self.quote_context.pending
+            safe = self.quote_view + (' ' if self.quote_context.preview() else pending)
+            if not safe.strip():
+                safe = ""
+        if complete:
+            if marker and self.fence is None:
+                self.fence = marker
+                self.tail = ""
+                self.fast.reset()
+            elif (marker and self.fence and marker[0] == self.fence[0]
+                  and len(marker) >= len(self.fence) and not stripped[len(marker):].strip()):
+                self.fence = None
+                self.tail = ""
+                self.fast.reset()
+            elif self.fence is None:
+                self.tail = (self.tail + safe + "\n")[-REASON_LOOP_TAIL:] if safe or not self.line.strip() else ""
+                if safe:
+                    hit = self.fast.feed_line(safe)
+                    if hit:
+                        self.hit, self.detail, self.rule = True, hit, hit.split(":")[0]
+                elif self.line.strip():
+                    self.fast.reset()
+            # Unmatched quotes in code/data must not hide later prose.
+            if (self.fence is not None or (self.line_blocked and not self.quote_line_start and
+                    not stripped.startswith(('"', "'", '“', '‘')))):
+                self.quote_context = _QuoteContext()
+            self.quote_line_start = self.quote_context.quote is not None
+            self.quote_view = ""
+            self.line = ""
+            self.line_blocked = False
+        if self.hit or self.fence or marker:
+            return self.hit
+        if safe or complete:
+            if not complete:
+                end = max((safe.rfind(mark) for mark in ".!?。！？"), default=-1)
+                if end >= 0:
+                    preview = FastStallGuard(self.conservative)
+                    preview.phrases = self.fast.phrases.copy()
+                    hit = preview.feed_line(safe[:end+1])
+                    if hit:
+                        self.hit, self.detail, self.rule = True, hit, hit.split(":")[0]
+            if not self.hit:
+                self._check(self.tail + ("" if complete else safe))
+        return self.hit
+
+    def feed(self, text):
+        """Schedule checks at absolute positions, independent of SSE partitions."""
+        if os.environ.get("WB_OPS_LOOP_GUARD", "1").lower() in ("0", "false", "off"):
+            return False
+        if self.hit or not text:
+            return self.hit
+        for char in text:
+            self.total_chars += 1
+            self.scanned += 1
+            if self.fence is None:
+                pending = self.quote_context.pending
+                protected = self.quote_context.feed(char)
+                if self.quote_context.expired:
+                    if not self.line_blocked:
+                        self.line = ""
+                    self.tail = ""
+                    self.fast.reset()
+                    self.quote_view = ""
+                if pending:
+                    self.quote_view = (self.quote_view + (' ' if protected else pending))[-REASON_LOOP_TAIL:]
+            if char == "\n":
+                if self._line_state(complete=True):
+                    return True
+            else:
+                self.line = (self.line + char)[-REASON_LOOP_TAIL:]
+            if self.scanned >= 64:
+                self.scanned = 0
+                if self._line_state():
+                    return True
+        return self.hit
+
+    def describe(self):
+        if self.rule.startswith("fast"):
+            return "short-intent repetition churn (" + self.detail + ")"
+        return self.detail or "reasoning repetition loop"
+
+    def evidence(self):
+        """Numeric-only shape of the bounded detection window, never text."""
+        tail = (self.tail + self.line)[-REASON_LOOP_TAIL:]
+        phrases = [" ".join(p.strip(" \t\r(),:，：\"'").split()).casefold()
+                   for p in re.split(r"[\n.!?。！？]+", unicodedata.normalize('NFKC', tail)) if p.strip()]
+        window = phrases[-48:]
+        short = [p for p in window if len(p) <= REASON_CHURN_MAX_LINE and len(p.split()) <= 12]
+        counts = Counter(_phrase_key(p) for p in short)
+        return {'window_chars': len(tail), 'window_lines': len(window),
+                'short_phrases': len(short), 'distinct_phrases': len(counts),
+                'repeated_phrases': sum(n for n in counts.values() if n >= 2),
+                'dominant_count': max(counts.values(), default=0),
+                'intent_lines': sum(bool(_STALL_RE.fullmatch(p)) for p in short)}
+
+
+class LeakedThinkingGuard:
+    """Detect-only leading-tag view. Never changes content or permits replay.
+
+    The caller may inject an independent, bounded mixed-stall detector after
+    selecting its supported model/request shape. This module does not import
+    that optional detector or extend its scope to arbitrary answer content.
+    """
+    def __init__(self, mixed_stall=None):
+        self.state = "probe"
+        self.probe = ""
+        self.pending = ""
+        self.tag = None
+        self.detected = False
+        self.guard = ReasoningLoopGuard()
+        self.mixed_stall = mixed_stall
+        self.mixed_metrics = None
+
+    @property
+    def hit(self):
+        return self.guard.hit or self.mixed_metrics is not None
+
+    @property
+    def rule(self):
+        return self.guard.rule if self.guard.hit else ("mixed-stall" if self.mixed_metrics else "")
+
+    @property
+    def total_chars(self):
+        if self.mixed_metrics is not None and not self.guard.hit:
+            return self.mixed_stall.total_chars
+        return self.guard.total_chars
+
+    def _feed_view(self, text, final=False):
+        self.guard.feed(text)
+        if self.mixed_stall is not None:
+            metrics = self.mixed_stall.feed(text, final=final)
+            if metrics:
+                self.mixed_metrics = metrics
+        return self.hit
+
+    def feed(self, text):
+        if self.hit:
+            return True
+        for ch in text:
+            if self.state == "done":
+                break
+            if self.state == "probe":
+                self.probe += ch
+                lead = self.probe.lstrip().lower()
+                tags = ("<thinking>", "<think>")
+                if lead in tags:
+                    self.state, self.detected = "active", True
+                    self.tag = "</thinking>" if lead == tags[0] else "</think>"
+                elif len(self.probe) > 64 or (lead and not any(t.startswith(lead) for t in tags)):
+                    self.state = "done"
+                continue
+            self.pending += ch
+            if self.pending.lower().endswith(self.tag):
+                # The bounded lookahead may still contain the newline that
+                # closes a preceding fence. Consume that prefix before asking
+                # whether this is the real thinking boundary, never the tag.
+                prefix = self.pending[:-len(self.tag)]
+                if prefix:
+                    self.pending = self.pending[-len(self.tag):]
+                    if self._feed_view(prefix):
+                        return True
+                if self.guard.fence is None and not self.guard.quote_context.preview():
+                    self._feed_view("", final=True)
+                    self.pending, self.state = "", "done"
+                    return self.hit
+            if len(self.pending) > len(self.tag):
+                part, self.pending = self.pending[0], self.pending[1:]
+                if self._feed_view(part):
+                    return True
+        return self.hit
+
+    def finish(self):
+        if self.hit:
+            self.pending = ""
+            return True
+        if self.state == "active":
+            self._feed_view(self.pending, final=True)
+            self.pending = ""
+        return self.hit
+
+
+class LoopRetryCircuit:
+    """Bounded TTL budget for identical request contexts; retains hashes only."""
+    def __init__(self, ttl=120, limit=256, clock=time.monotonic):
+        self.ttl, self.limit, self.clock = ttl, limit, clock
+        self.entries = {}
+        self.lock = threading.Lock()
+
+    def allow(self, key):
+        if not key:
+            return True
+        with self.lock:
+            now = self.clock()
+            self.entries = {k: v for k, v in self.entries.items() if now - v[0] < self.ttl}
+            start, count = self.entries.get(key, (now, 0))
+            if key not in self.entries and len(self.entries) >= self.limit:
+                self.entries.pop(next(iter(self.entries)))
+            self.entries[key] = (start, min(count + 1, 2))
+            return count == 0
+
+    def success(self, key):
+        with self.lock:
+            self.entries.pop(key, None)
+
