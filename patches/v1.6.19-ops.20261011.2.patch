+def strip_data_prefix(line):
+    line = line.strip()
+    # SSE comment / heartbeat / keepalive / empty line
+    if not line or line.startswith(":"):
+        return ""
+    while line.startswith("data:"):
+        line = line[5:].strip()
+    # Handle possible "data: : heartbeat"
+    if not line or line.startswith(":"):
+        return ""
+    return line
