+        pos = n
+        while pos >= ulen and tail[pos - ulen:pos] == unit:
+            reps += 1
+            pos -= ulen
+        if reps >= need and reps * ulen >= span_need:
+            return "repeated unit %d times (%d bytes): %r" % (reps, reps * ulen, unit[:40])
