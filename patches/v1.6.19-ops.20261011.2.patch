+class FastStallGuard:
+    """Small high-confidence intent window, never spanning code or real prose."""
+
+    def __init__(self, conservative=False):
+        self.phrases = deque(maxlen=48)
+        self.conservative = conservative
+
+    def reset(self):
+        self.phrases.clear()
